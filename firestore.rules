rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myProfile() {
      return profile(request.auth.uid);
    }

    function myFamilyId() {
      return myProfile().data.familyId;
    }

    function family(fid) {
      return get(/databases/$(database)/documents/families/$(fid));
    }

    function member(fid) {
      return signedIn()
        && myFamilyId() == fid
        && request.auth.uid in family(fid).data.memberIds;
    }

    function owner(fid) {
      return member(fid)
        && family(fid).data.ownerUid == request.auth.uid;
    }

    /*
     * USER PROFILES
     *
     * Users can create their own account profile.
     * Users can read only their own profile.
     *
     * A client cannot directly change familyId or partnerUid once the
     * relationship exists. Partner pairing is handled by the invite flow.
     */
    match /users/{uid} {
      allow create: if self(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.familyId == null
        && request.resource.data.partnerUid == null;

      allow read: if self(uid);

      allow update: if self(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.partnerUid == resource.data.partnerUid;

      allow delete: if self(uid);
    }

    /*
     * FAMILIES
     *
     * A family starts with exactly one member.
     * A family can never contain more than two members.
     *
     * The owner can update family settings, but normal client writes cannot
     * manufacture or remove members.
     */
    match /families/{fid} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.memberCount == 1;

      allow read: if member(fid);

      allow update: if member(fid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.memberCount == resource.data.memberCount;

      allow delete: if owner(fid);

      match /checkins/{id} {
        allow read: if member(fid);

        allow create: if member(fid)
          && request.resource.data.createdByUid == request.auth.uid;

        allow update, delete: if member(fid)
          && resource.data.createdByUid == request.auth.uid;
      }

      match /babyActivity/{id} {
        allow read: if member(fid);

        allow create: if member(fid)
          && request.resource.data.createdByUid == request.auth.uid;

        allow update, delete: if member(fid)
          && resource.data.createdByUid == request.auth.uid;
      }

      match /notifications/{id} {
        allow read, create, update, delete: if member(fid);
      }
    }

    /*
     * PARTNER INVITES
     *
     * Anyone authenticated may read a specific invitation code so that a
     * partner can redeem a code they have received.
     *
     * Only a one-member family owner can create an open invite.
     */
    match /partnerInvites/{code} {
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.familyId == myFamilyId()
        && owner(request.resource.data.familyId)
        && family(request.resource.data.familyId).data.memberIds.size() == 1;

      allow read: if signedIn();

      allow update: if signedIn()
        && resource.data.status == "open"
        && request.resource.data.status == "used"
        && request.resource.data.usedByUid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.createdByUid == request.auth.uid;
    }

    /*
     * DENY EVERYTHING ELSE
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
