rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myProfile() {
      return profile(request.auth.uid);
    }

    function myFamilyId() {
      return myProfile().data.familyId;
    }

    function family(fid) {
      return get(/databases/$(database)/documents/families/$(fid));
    }

    function member(fid) {
      return signedIn()
        && myFamilyId() == fid
        && request.auth.uid in family(fid).data.memberIds;
    }

    function owner(fid) {
      return member(fid)
        && family(fid).data.ownerUid == request.auth.uid;
    }

    // USER PROFILES
    match /users/{uid} {
      allow create: if self(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.familyId == null
        && request.resource.data.partnerUid == null;

      allow read: if self(uid);

      allow update: if self(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (
          // Ordinary profile update; relationship fields do not change.
          (
            request.resource.data.familyId == resource.data.familyId
            && request.resource.data.partnerUid == resource.data.partnerUid
          )
          ||
          // Newly registered Mum attaches to her own newly-created family.
          (
            resource.data.familyId == null
            && request.resource.data.familyId != null
            && family(request.resource.data.familyId).data.ownerUid == request.auth.uid
            && family(request.resource.data.familyId).data.memberIds.size() == 1
            && family(request.resource.data.familyId).data.memberIds[0] == request.auth.uid
            && request.resource.data.partnerUid == null
          )
          ||
          // Newly registered Partner attaches to a valid two-person family.
          (
            resource.data.familyId == null
            && request.resource.data.familyId != null
            && family(request.resource.data.familyId).data.memberIds.size() == 2
            && request.auth.uid in family(request.resource.data.familyId).data.memberIds
            && request.resource.data.partnerUid != null
            && request.resource.data.partnerUid in family(request.resource.data.familyId).data.memberIds
            && request.resource.data.partnerUid != request.auth.uid
          )
        );

      allow delete: if self(uid);
    }

    // FAMILIES
    match /families/{fid} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.memberCount == 1;

      allow read: if member(fid);

      allow update: if member(fid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          // Normal family settings update; membership unchanged.
          (
            request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.memberCount == resource.data.memberCount
          )
          ||
          // Partner joins: one existing member + the authenticated caller.
          (
            resource.data.memberIds.size() == 1
            && resource.data.memberCount == 1
            && request.resource.data.memberIds.size() == 2
            && request.resource.data.memberCount == 2
            && request.resource.data.memberIds[0] == resource.data.memberIds[0]
            && request.resource.data.memberIds[1] == request.auth.uid
            && request.auth.uid != resource.data.memberIds[0]
          )
        );

      allow delete: if owner(fid);

      match /checkins/{id} {
        allow read: if member(fid);
        allow create: if member(fid)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if member(fid)
          && resource.data.createdByUid == request.auth.uid;
      }

      match /babyActivity/{id} {
        allow read: if member(fid);
        allow create: if member(fid)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if member(fid)
          && resource.data.createdByUid == request.auth.uid;
      }

      match /notifications/{id} {
        allow read, create, update, delete: if member(fid);
      }
    }

    // PARTNER INVITES
    match /partnerInvites/{code} {
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.familyId == myFamilyId()
        && owner(request.resource.data.familyId)
        && family(request.resource.data.familyId).data.memberIds.size() == 1;

      allow read: if signedIn();

      allow update: if signedIn()
        && resource.data.status == "open"
        && request.resource.data.status == "used"
        && request.resource.data.usedByUid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.createdByUid == request.auth.uid;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
